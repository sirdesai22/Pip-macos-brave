{
  "manifest_version": 3,
  "name": "Native PiP for YouTube",
  "version": "0.1.0",
  "description": "Open YouTube videos in a native macOS floating player that stays above fullscreen apps.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "dist/background.js" },
  "action": { "default_title": "Open in Native PiP" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
